{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/cybersecurity-ai-skills-unified/main/schema/unified-skill.schema.json",
  "title": "Unified Cybersecurity AI Skill Schema",
  "description": "跨平台/跨Agent网络安全AI技能统一数据格式标准。融合 agentskills.io 开放标准与国内Agent平台规范，支持中英双语、多框架映射与AI Agent自动发现。",
  "type": "object",
  "required": ["name", "description", "domain", "subdomain"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64,
      "description": "技能唯一标识符 (kebab-case)，用于AI Agent索引与路由匹配"
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 500,
      "description": "技能描述文本，包含关键词以优化AI Agent语义搜索匹配度"
    },
    "domain": {
      "type": "string",
      "enum": ["cybersecurity"],
      "description": "顶级领域分类。当前统一为 cybersecurity"
    },
    "subdomain": {
      "type": "string",
      "enum": [
        "reconnaissance",
        "vulnerability-scanning",
        "exploitation",
        "privilege-escalation",
        "post-exploitation",
        "lateral-movement",
        "persistence",
        "covering-tracks",
        "social-engineering",
        "wireless-security",
        "mobile-security",
        "reverse-engineering",
        "penetration-testing",
        "red-blue-team",
        "threat-hunting",
        "threat-intelligence",
        "incident-response",
        "digital-forensics",
        "soc-operations",
        "endpoint-security",
        "ransomware-defense",
        "malware-analysis",
        "network-security",
        "deception-technology",
        "phishing-defense",
        "reporting",
        "vulnerability-management",
        "security-operations",
        "cloud-security",
        "container-security",
        "api-security",
        "code-audit",
        "supply-chain-security",
        "os-security",
        "iam",
        "cryptography-pki",
        "zero-trust",
        "llm-security",
        "ics-ot-security",
        "blockchain-web3-security",
        "iot-security",
        "devsecops",
        "security-audit",
        "governance-compliance",
        "data-security-privacy"
      ],
      "description": "安全子领域分类 (42个细分领域)"
    },
    "mitre_attack": {
      "type": "array",
      "items": {"type": "string", "pattern": "^T\\d{4}(\\.\\d{3})?$"},
      "description": "MITRE ATT&CK v18 技术ID映射"
    },
    "mitre_attack_tactic": {
      "type": "array",
      "items": {"type": "string", "pattern": "^TA\\d{4}$"},
      "description": "MITRE ATT&CK 战术阶段"
    },
    "nist_csf": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Z]{2}\\.[A-Z]{2}-\\d{2}$"},
      "description": "NIST CSF 2.0 子类别引用 (如 DE.CM-01)"
    },
    "mitre_atlas": {
      "type": "array",
      "items": {"type": "string", "pattern": "^AML\\.T\\d{4}$"},
      "description": "MITRE ATLAS v5.4 AI/ML对抗技术映射"
    },
    "mitre_d3fend": {
      "type": "array",
      "items": {"type": "string", "pattern": "^D3-[A-Z]+$"},
      "description": "MITRE D3FEND v1.3 防御对策映射"
    },
    "nist_ai_rmf": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Z]+-\\d+\\.\\d+$"},
      "description": "NIST AI RMF 1.0 子类别引用"
    },
    "cn_standard": {
      "type": "array",
      "items": {"type": "string"},
      "description": "国内合规标准映射 (如 '等保2.0-安全计算环境')"
    },
    "iso_27001": {
      "type": "array",
      "items": {"type": "string", "pattern": "^A\\.\\d+\\.\\d+\\.\\d+$"},
      "description": "ISO 27001:2022 Annex A 控制项映射"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-z0-9.]+)?$",
      "description": "语义化版本号 (SemVer)"
    },
    "difficulty": {
      "type": "string",
      "enum": ["★☆☆☆☆", "★★☆☆☆", "★★★☆☆", "★★★★☆", "★★★★★"],
      "description": "难度等级 (1-5星)"
    },
    "author": {
      "type": "string",
      "description": "技能作者标识"
    },
    "license": {
      "type": "string",
      "enum": ["MIT", "Apache-2.0", "CC-BY-4.0", "GPL-3.0"],
      "description": "许可证类型"
    },
    "source_repos": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "description": "来源追溯: 上游仓库引用"
    },
    "estimated_tokens": {
      "type": "integer",
      "minimum": 100,
      "maximum": 10000,
      "description": "预估完整加载此技能的Token消耗量"
    },
    "execution_time": {
      "type": "string",
      "enum": ["short", "medium", "long", "async"],
      "description": "预期执行耗时分类"
    },
    "requires_tools": {
      "type": "array",
      "items": {"type": "string"},
      "description": "技能执行依赖的工具/库列表"
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["all", "claude-code", "cursor", "trae", "flocks", "deepseek-v4", "copilot", "gemini-cli", "codex-cli"]
      },
      "description": "已验证兼容的平台列表"
    },
    "optimized_for": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["deepseek-v4", "claude", "gpt-4", "gemini", "llama", "qwen", "local"]
      },
      "description": "已进行专项优化的模型平台"
    },
    "tags": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "description": "英文标签 (用于AI Agent语义匹配与过滤)"
    },
    "name_cn": {
      "type": "string",
      "description": "技能中文名称 (国内Agent适配)"
    },
    "category_cn": {
      "type": "string",
      "description": "中文分类"
    },
    "difficulty_cn": {
      "type": "string",
      "enum": ["★☆☆☆☆", "★★☆☆☆", "★★★☆☆", "★★★★☆", "★★★★★"],
      "description": "中文难度等级"
    },
    "tags_cn": {
      "type": "array",
      "items": {"type": "string"},
      "description": "中文标签"
    }
  }
}
