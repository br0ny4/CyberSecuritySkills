{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "CyberSecuritySkills MCP Registry",
  "description": "网络安全工具 MCP 服务器统一注册清单 — 供 AI Agent 自动发现与配置",
  "version": "1.0.0",
  "updated": "2026-05-20",

  "servers": [
    {
      "id": "ida-pro-mcp",
      "name": "IDA Pro MCP",
      "description": "IDA Pro 逆向工程 MCP 服务器 — 反编译/反汇编/交叉引用/调试/内存操作",
      "repo": "https://github.com/mrexodia/ida-pro-mcp",
      "stars": "high",
      "license": "MIT",
      "tier": 1,
      "category": "reverse-engineering",
      "transport": ["stdio", "sse", "streamable-http"],
      "install": {
        "claude_code": "claude plugin marketplace add mrexodia/claude-marketplace && claude plugin install ida-pro-mcp@mrexodia",
        "manual": "uv run ida-pro-mcp --transport http://127.0.0.1:8744/sse",
        "headless": "uv run idalib-mcp --host 127.0.0.1 --port 8745 path/to/binary"
      },
      "tools": ["decompile", "disasm", "xrefs_to", "callees", "lookup_funcs", "int_convert", "set_comments", "patch_asm", "get_bytes", "get_string", "stack_frame", "read_struct", "search_structs", "define_func", "declare_type", "dbg_start", "dbg_add_bp", "dbg_regs", "dbg_stacktrace"],
      "resources": ["ida://idb/metadata", "ida://idb/segments", "ida://idb/entrypoints", "ida://cursor", "ida://types", "ida://structs", "ida://import/{name}", "ida://xrefs/from/{addr}"]
    },
    {
      "id": "burpsuite-mcp",
      "name": "BurpSuite MCP Server",
      "description": "BurpSuite Web渗透测试 MCP — 代理拦截/扫描/漏洞检测/流量分析",
      "repo": "https://github.com/X3r0K/BurpSuite-MCP-Server",
      "stars": 1400,
      "license": "MIT",
      "tier": 1,
      "category": "web-pentesting",
      "transport": ["http-sse"],
      "install": {
        "manual": "git clone https://github.com/X3r0K/BurpSuite-MCP-Server.git && cd BurpSuite-MCP-Server && pip install -r requirements.txt && python main.py"
      },
      "endpoints": {
        "proxy": "/proxy/intercept",
        "scanner_start": "/scanner/start",
        "scanner_status": "/scanner/status/{id}",
        "logger": "/logger/logs",
        "vulnerabilities": "/logger/vulnerabilities",
        "vulnerabilities_severity": "/logger/vulnerabilities/severity",
        "analysis": "/logger/analysis"
      },
      "vuln_detection": ["XSS", "SQLi", "Path Traversal", "File Inclusion", "SSRF", "XXE", "CSRF", "Open Redirect", "Command Injection"],
      "env_vars": ["BURP_API_KEY", "BURP_API_HOST", "BURP_API_PORT", "BURP_PROXY_HOST", "BURP_PROXY_PORT", "MCP_SERVER_HOST", "MCP_SERVER_PORT"]
    },
    {
      "id": "shodan-mcp",
      "name": "Shodan MCP",
      "description": "Shodan 网络空间搜索引擎 MCP — IP查询/设备搜索/DNS/CVE/CPE",
      "repo": "https://github.com/BurtTheCoder/Shodan-MCP",
      "stars": 186,
      "license": "MIT",
      "tier": 1,
      "category": "threat-intelligence",
      "transport": ["stdio"],
      "install": {
        "manual": "git clone https://github.com/BurtTheCoder/Shodan-MCP.git && cd Shodan-MCP && pip install -r requirements.txt"
      },
      "tools": ["ip_lookup", "device_search", "dns_lookup", "cve_query", "cpe_query"],
      "env_vars": ["SHODAN_API_KEY"]
    },
    {
      "id": "virustotal-mcp",
      "name": "VirusTotal MCP",
      "description": "VirusTotal 多引擎恶意软件检测 MCP — 文件/URL/Hash扫描",
      "repo": "community (腾讯云MCP广场收录)",
      "license": "MIT",
      "tier": 2,
      "category": "threat-intelligence",
      "transport": ["stdio"],
      "tools": ["file_scan", "url_scan", "hash_lookup", "domain_report"],
      "env_vars": ["VIRUSTOTAL_API_KEY"]
    },
    {
      "id": "ghidra-mcp",
      "name": "Ghidra MCP (Wrapper)",
      "description": "Ghidra 开源逆向工程 MCP 封装 — ghidra_bridge Python API → MCP stdio",
      "repo": "bundled (CyberSecuritySkills/mcp/scripts/ghidra_mcp_server.py)",
      "license": "MIT",
      "tier": 3,
      "category": "reverse-engineering",
      "transport": ["stdio"],
      "tools": ["ghidra_decompile", "ghidra_disassemble", "ghidra_xrefs", "ghidra_search", "ghidra_rename", "ghidra_set_type"],
      "dependencies": ["ghidra-bridge", "mcp"],
